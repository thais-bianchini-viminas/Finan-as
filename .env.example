# Banco (Supabase/Postgres)
DATABASE_URL=
DIRECT_URL=

# Bot do Telegram (gere um novo no @BotFather com /revoke se o antigo vazou)
TELEGRAM_BOT_TOKEN=
# Texto aleatório longo; o Telegram envia de volta em todo webhook
TELEGRAM_WEBHOOK_SECRET=
# IDs de chat autorizados, separados por vírgula (o bot informa o ID de quem não está na lista)
ALLOWED_CHAT_IDS=

# Senha do painel/app. Sem ela, o painel fica aberto como antes.
APP_PASSWORD=
# Opcional: segredo para assinar a sessão (padrão: a própria APP_PASSWORD)
AUTH_SECRET=

APP_URL=https://finan-as-rose.vercel.app

# Notificações do app (gere com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
